rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // FUNGSI BANTUAN (HELPERS)
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'SUPER_ADMIN' || 
        getUserData().role == 'ADMIN'
      );
    }
    
    function isOrganizer() {
      return isAuthenticated() && (
        getUserData().role == 'ORGANIZER' || 
        isAdmin()
      );
    }

    // ==========================================
    // 1. DATA PUBLIK (Semua Boleh Baca, Admin/Organizer Boleh Tulis)
    // ==========================================
    match /system_settings/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /events/{document=**} { allow read: if true; allow write: if isOrganizer(); }
    match /event_categories/{document=**} { allow read: if true; allow write: if isOrganizer(); }
    match /sponsors/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /pages/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /faqs/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /galleries/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /announcements/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /race_results/{document=**} { allow read: if true; allow write: if isOrganizer(); }
    match /certificates/{document=**} { allow read: if true; allow write: if isOrganizer(); }
    match /participants/{document=**} { allow read: if true; allow create: if isAuthenticated(); allow update: if isAuthenticated(); allow delete: if isAdmin(); }

    // ==========================================
    // 2. DATA SENSITIF PENGGUNA (Hanya Pemilik & Admin)
    // ==========================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }
    
    match /registrations/{registrationId} {
      allow read: if isAuthenticated() && (isAdmin() || isOwner(resource.data.userId) || isOrganizer());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (isAdmin() || isOwner(resource.data.userId) || isOrganizer());
      allow delete: if isAdmin();
    }
    
    match /medical_assessments/{assessmentId} {
      allow read: if isAuthenticated() && (isAdmin() || isOwner(resource.data.userId));
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (isAdmin() || isOwner(resource.data.userId));
      allow delete: if isAdmin();
    }

    // ==========================================
    // 3. PEMBAYARAN, AUDIT, & SISTEM INTERNAL (Sangat Ketat)
    // ==========================================
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (isAdmin() || isOwner(resource.data.userId) || isOrganizer());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || isOrganizer();
    }
    
    match /race_packs/{packId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isOrganizer();
    }
    
    match /payouts/{id} {
      allow read, write: if isAuthenticated() && (isAdmin() || isOrganizer());
    }
    
    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable (Tidak bisa diubah/dihapus)
    }

    // ==========================================
    // 4. ATURAN PENYELAMAT (Sapu Jagat)
    // ==========================================
    // Memastikan tidak ada koleksi tertinggal yang membuat error jika diakses Admin.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
